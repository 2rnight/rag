# ==================== 模型接入 ====================
# auto = 有 DASHSCOPE_API_KEY 用 qwen，有 OPENAI_API_KEY 用 openai，都没有则走离线兜底
RAG_LLM_PROVIDER=auto
RAG_EMBEDDING_PROVIDER=auto

# 通义千问（DashScope 的 OpenAI 兼容模式）
DASHSCOPE_API_KEY=
RAG_LLM_MODEL=qwen-plus
RAG_EMBEDDING_MODEL=text-embedding-v3
RAG_EMBEDDING_DIM=1024

# OpenAI（二选一）
OPENAI_API_KEY=
# RAG_LLM_MODEL=gpt-4o-mini
# RAG_EMBEDDING_MODEL=text-embedding-3-small

# ==================== 切片与检索 ====================
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP_RATIO=0.2
RAG_RETRIEVAL_TOP_K=5
RAG_RETRIEVAL_FETCH_K=20
RAG_HYBRID_ENABLED=true
# <0 表示使用向量模型的经验阈值（qwen 0.35 / openai 0.30 / local 0.20）
RAG_SCORE_THRESHOLD=-1
RAG_MAX_UNKNOWN_RATIO=0.65
RAG_CONTEXT_TOKEN_BUDGET=3000

# ==================== 服务 ====================
RAG_HOST=0.0.0.0
RAG_PORT=8000
RAG_LOG_LEVEL=INFO
RAG_LOG_JSON=false
RAG_SSE_HEARTBEAT_INTERVAL=15
RAG_MAX_UPLOAD_MB=50

# ==================== 生成兜底 ====================
RAG_LLM_FIRST_TOKEN_TIMEOUT=20
RAG_STRICT_GROUNDING=false
